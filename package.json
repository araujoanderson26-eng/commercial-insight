{
  "name": "comercial-insight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "oxlint src worker shared scripts tests --deny-warnings",
    "build": "npm run typecheck && vite build && node scripts/package-preparer.mjs && node scripts/sw.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node --import tsx tests/ui-smoke.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "admin": "node scripts/admin.mjs",
    "deploy": "node scripts/check-release.mjs && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@noble/hashes": "^2.4.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.4.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261117.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsonc-parser": "^3.3.1",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "wrangler": "^4.164.0"
  }
}
