{
  "name": "comercial-insight",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev --local",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "oxlint src worker shared scripts tests --deny-warnings",
    "build": "npm run typecheck && vite build && node scripts/package-preparer.mjs && node scripts/sw.mjs",
    "build:mobile": "npm run typecheck && node scripts/build-mobile.mjs --env=production",
    "build:mobile:hml": "npm run typecheck && node scripts/build-mobile.mjs --env=hml",
    "mobile:sync": "npm run build:mobile && npx cap sync",
    "mobile:sync:hml": "npm run build:mobile:hml && npx cap sync",
    "mobile:android": "npm run mobile:sync && npx cap open android",
    "mobile:ios": "npm run mobile:sync && npx cap open ios",
    "mobile:apk": "npm run build:mobile && npx cap sync android && node scripts/build-android.mjs --task=assembleDebug",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:ui": "node --import tsx tests/ui-smoke.ts",
    "test:executive": "node --import tsx tests/executive-ui-smoke.ts",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:hml": "node scripts/check-hml.mjs && npm run build && wrangler deploy --config wrangler.hml.jsonc",
    "check:hml": "node scripts/check-hml.mjs",
    "admin": "node scripts/admin.mjs",
    "deploy": "node scripts/check-release.mjs && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/network": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource-variable/inter": "^5.2.5",
    "@noble/hashes": "^2.4.0",
    "echarts": "^6.1.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@cloudflare/workers-types": "5.20261117.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsonc-parser": "^3.3.1",
    "oxlint": "^1.94.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "wrangler": "^4.164.0"
  }
}
