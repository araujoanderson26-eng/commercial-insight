# Origem HTTPS da API de Produção usada ao compilar o app mobile (Android/iOS) com Capacitor
VITE_API_BASE_URL=https://commercial-insight.araujoempresarial.com.br
VITE_APP_ENV=production

# Origens permitidas no Worker Cloudflare para requisições do app nativo Capacitor
# Configuradas em wrangler.jsonc (sem segredos)
MOBILE_ORIGINS=capacitor://localhost,https://localhost
