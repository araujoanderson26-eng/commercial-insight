
{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "commercial-insight",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-18",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "workers_dev": true,
  "preview_urls": false,

  "limits": { "cpu_ms": 60000 },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comercial-insight-db",
      "database_id": "5b333eba-7ace-4182-aa76-0d0f591a4ad6",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "commercial-insight-arquivos"
    }
  ],

  "queues": {
    "producers": [{ "binding": "MANUAL_JOBS", "queue": "commercial-insight-manual-jobs" }],
    "consumers": [{ "queue": "commercial-insight-manual-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 5, "retry_delay": 30 }]
  },

  "vars": {
   "APP_ORIGIN": "https://commercial-insight.araujoempresarial.com.br",
    "OPENAI_MODEL": "gpt-4.1-mini-2025-04-14",
    "PRODUCTION_AI_BUDGET": "true",
    "RETENTION_DAYS": "90",
    "MANUAL_MAX_BYTES": "536870912",
    "MANUAL_D1_CAPACITY_BYTES": "9663676416"
  },

  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },

  "triggers": {
    "crons": [
      "* * * * *",
      "17 4 * * *"
    ]
  }
}
